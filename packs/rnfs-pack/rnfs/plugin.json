{
  "plugin": "rnfs",
  "title": "rnfs (Reticulum file system links and shelf)",
  "version": "1.0",
  "plugin_api": 1,
  "summary": "Spots rnfs links in chat (web and LoRa) and keeps the place's own shelf of them: !shelf, a page at /p/rnfs/, and rnfs itself on the Tools page.",
  "modifies_core_files": false,
  "binds_ports": false,
  "starts_tasks": false,
  "hooks": [
    "/shelf /rnfs (and !shelf ...)",
    "on_message: link spotter",
    "every 60 s: saves",
    "page /p/rnfs/ (home card), /p/rnfs/shelf.json"
  ],
  "runtime_storage": {
    "path": "/sd/plugins/rnfs/shelf.json",
    "note": "The shelf and links seen in chat."
  },
  "wizard": {
    "prompts": [
      {
        "key": "RNFS_HINTS",
        "prompt": "Post a short 'how to fetch this' hint when someone shares an rnfs link (at most every 10 minutes per room)",
        "type": "choice",
        "options": [
          "True",
          "False"
        ],
        "default": "True",
        "advanced": true,
        "writes_to": "config.py"
      }
    ]
  },
  "files": [
    "rnfs/__init__.py",
    "rnfs/install.py",
    "rnfs/strings.py",
    "rnfs/plugin.json"
  ],
  "hashes": {
    "rnfs/__init__.py": "110590c542886bf6",
    "rnfs/install.py": "b2d07f93fd98401f",
    "rnfs/strings.py": "c8f7d88c46f44e93"
  }
}
